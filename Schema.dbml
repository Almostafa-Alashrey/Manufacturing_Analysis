Table Dim_Date{
  date_key int [pk]
  full_date date
  year int
  quarter int
  month_name varchar(20)
  month int
  day_name varchar(20)
  day int
  day_of_year int
  week_of_year int
  is_weekend bit
}

Table Dim_Shift{
  shift_key int [pk]
  shift varchar(20)
  shift_name varchar(20)
}

Table Dim_Machine{
  machine_key int [pk]
  machine_id varchar(10)
}

Table Dim_Operator{
  operator_key int [pk]
  operator_id varchar(10)
}

Table Dim_Product{
  product_key int [pk]
  product_id varchar(10)
}

Table Dim_Quality{
  quality_key int [pk]
  "type" char(1)
  product_quality varchar(10)
}

Table Dim_Downtime_Reason{
  downtime_reason_key int [pk]
  downtime_reason varchar(50)
}

Table Dim_Defect_Type{
  defect_type_key int [pk]
  defect_type varchar(50)
}

Table Fact_Production{
  date_key int [not null, ref: > Dim_Date.date_key]
  shift_key int [not null, ref: > Dim_Shift.shift_key]
  machine_key int [not null, ref: > Dim_Machine.machine_key]
  operator_key int [not null, ref: > Dim_Operator.operator_key]
  product_key int [not null, ref: > Dim_Product.product_key]
  quality_key int [not null, ref: > Dim_Quality.quality_key]
  downtime_reason_key int [not null, ref: > Dim_Downtime_Reason.downtime_reason_key]
  defect_type_key int [not null, ref: > Dim_Defect_Type.defect_type_key]
  planned_time_min int
  downtime_min int
  total_units int
  good_units int
  reject_units int
  energy_kwh decimal(10,2)
  air_temperature_k decimal(6,1)
  process_temperature_k decimal(6,1)
  rotational_speed_rpm int
  torque_nm decimal(6,2)
  tool_wear_min int
  machine_failure bit
  indexes {
    (date_key, shift_key, machine_key) [pk]
  }
}
